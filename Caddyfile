# ---------------------------------------------------------------
# Reverse proxy con TLS automático (Let's Encrypt).
#
# El dominio sale del entorno. Por defecto es `localhost`, que Caddy sirve con
# su CA interna: eso permite levantar el stack completo y probarlo sin DNS ni
# certificados reales. En el VPS se define SITE_DOMAIN / SITE_WWW en el `.env`.
# ---------------------------------------------------------------

{$SITE_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy web:3000
}

# www redirige al dominio sin www, para no partir el SEO en dos orígenes.
{$SITE_WWW:www.localhost} {
	redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}
