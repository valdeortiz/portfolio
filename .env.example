# URL pública del sitio (usada por metadata, sitemap y Open Graph).
# Se inlinea en build-time: cambiarla exige reconstruir la imagen.
NEXT_PUBLIC_SITE_URL=https://valdeortiz.com

# Dominios que atiende Caddy. Si se dejan sin definir, usa `localhost` con su
# CA interna, que sirve para probar el stack completo sin DNS.
SITE_DOMAIN=valdeortiz.com
SITE_WWW=www.valdeortiz.com
